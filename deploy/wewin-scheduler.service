[Unit]
Description=WeWin single order scheduler
After=network-online.target
Wants=network-online.target

[Service]
User=wewin
Group=wewin
WorkingDirectory=/srv/wewin/app/Server
EnvironmentFile=/etc/wewin/app.env
ExecStart=/opt/wewin-venv/bin/python manage.py run_scheduler
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wewin

[Install]
WantedBy=multi-user.target
