[Unit]
Description=WeWin unreferenced media cleanup
[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/wewin/app/Server
EnvironmentFile=/etc/wewin/app.env
ExecStart=/opt/wewin-venv/bin/python manage.py cleanup_media
TimeoutStartSec=120
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wewin /var/cache/wewin-media
