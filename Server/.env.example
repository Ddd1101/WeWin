# Django 配置
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS 配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 数据库配置（可选，默认使用 SQLite）
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Production: WEWIN_ENV_FILE=/etc/wewin/app.env, DEBUG=False, strong SECRET_KEY
# Keep runtime data outside the Git checkout.
# DB_NAME=/var/lib/wewin/db.sqlite3
# MEDIA_ROOT=/var/lib/wewin/media
# MEDIA_URL=https://47.250.165.79/media/
# MEDIA_PROBE_FILE=.wewin-ready
# MEDIA_WRITE_STATUS_FILE=/var/lib/wewin/media-write-status.json
# MEDIA_REQUIRE_MOUNT=False
# TRUST_PROXY=True
# CSRF_TRUSTED_ORIGINS=https://47.250.165.79
# WRITE_LOCK_FILE=/var/lib/wewin/writes.lock
# SCHEDULER_LOCK_FILE=/var/lib/wewin/scheduler.lock
# BACKUP_STATUS_FILE=/var/lib/wewin/backup-status.json
# BACKUP_MAX_AGE_SECONDS=90000
# STATIC_ROOT=/srv/wewin/static

# N1 production origin (actual credentials stay outside Git)
# MEDIA_ORIGIN_URL=http://127.0.0.1:10080
# MEDIA_ORIGIN_READ_TOKEN=generated-read-credential
# MEDIA_ORIGIN_WRITE_TOKEN=generated-write-credential
# MEDIA_CLEANUP_DIR=/var/lib/wewin/media-cleanup
# MEDIA_CACHE_ROOT=/var/cache/wewin-media
# FILE_UPLOAD_TEMP_DIR=/var/lib/wewin-upload/django
